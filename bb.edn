{:deps {io.github.abogoyavlensky/manifest-edn {:mvn/version "0.1.1"}}
 :paths ["bb"]
 :tasks
 {:init (do
          (def input-css-file "resources/public/css/input.css")
          (def output-css-file "resources/public/css/output.css")
          (require 'replware.levinrag.bb.dotenv)
          ;; `clojure` plus the .env variables not already set in the shell;
          ;; for the tasks that run the app (SPEC.md §5). .env is read on
          ;; each call, so a syntax error in it only stops those tasks.
          (defn clj [& args]
            (let [file-env (try (replware.levinrag.bb.dotenv/read-file ".env")
                                (catch clojure.lang.ExceptionInfo e
                                  (binding [*out* *err*] (println "錯誤：" (ex-message e)))
                                  (System/exit 1)))]
              (apply clojure
                     {:extra-env (replware.levinrag.bb.dotenv/extra-env file-env (into {} (System/getenv)))}
                     args))))
  :enter (println "Running task:" (:name (current-task)))

  deps {:doc "Install all deps"
        :task (do
                (clojure "-P -X:dev")
                (clojure "-P -X:test")
                (clojure "-P -X:outdated")
                (clojure "-P -X:build")
                (clojure "-P"))}

  fmt-check {:doc "Check code formatting"
             :task (shell "cljfmt" "check")}

  fmt {:doc "Fix code formatting"
       :task (shell "cljfmt" "fix")}

  lint-init {:doc "Linting project's classpath"
             :task (shell "clj-kondo" "--parallel" "--dependencies" "--copy-configs"
                     "--lint" (with-out-str (clojure "-Spath")))}

  lint {:doc "Linting project's code"
        :task (shell "clj-kondo" "--parallel" "--lint" "src" "test" "bb")}

  outdated-check {:doc "Check outdated Clojure deps versions"
                  :task (clojure "-M:outdated")}

  outdated {:doc "Upgrade outdated Clojure deps versions"
            :task (clojure "-M:outdated --upgrade --force")}

  test {:doc "Run tests"
        :task (clojure "-X:test:jvm-opts")}

  check {:doc "Run all code checks and tests (what CI runs; does not change files)"
         :depends [fmt-check lint docs:check test]}

  docs:check {:doc "Bilingual docs in sync: headings, language switches, links and anchors"
              :extra-paths ["dev"]
              :requires ([docs-check])
              :task (docs-check/-main)}

  css-watch {:doc "Rebuild css on file change in watch mode"
             ; Use "exec" to be able to run in the repl
             :task (shell "mise" "exec" "--" "tailwindcss" "-i" input-css-file "-o" output-css-file "--watch")}

  css-build {:doc "Build minified css"
             :task (shell "tailwindcss" "-i" input-css-file "-o" output-css-file "--minify")}

  fetch-assets {:doc "Fetch static file assets from URLs"
                :requires ([manifest-edn.core :as manifest])
                :task (manifest/fetch-assets!
                        [{:url "https://unpkg.com/htmx.org@2.0.4/dist/htmx.min.js"
                          :filepath "js/htmx.min.js"}
                         {:url "https://cdn.jsdelivr.net/npm/alpinejs@3.14.8/dist/cdn.min.js"
                          :filepath "js/alpinejs.min.js"}])}

  build {:doc "Build application uberjar"
         :requires ([manifest-edn.core :as manifest])
         :task (do
                 (run 'css-build)
                 (manifest/hash-assets!)
                 (clojure "-T:build:jvm-opts build"))}

  vllm:check {:doc "Check embed/rerank/chat vLLM endpoints are reachable"
              :task (clj "-X:vllm-check")}

  doctor {:doc "Check a fresh checkout: tools, .env, corpus, permissions files, then bb vllm:check"
          :requires ([replware.levinrag.bb.doctor :as doctor]
                     [replware.levinrag.bb.dotenv :as dotenv])
          :task (let [[file-env env-err] (try [(dotenv/read-file ".env")]
                                              (catch clojure.lang.ExceptionInfo e [{} (ex-message e)]))
                      results (concat (when env-err [{:level :fail :item ".env" :msg env-err}])
                                      (doctor/run-checks (merge file-env (into {} (System/getenv)))
                                                         (.isFile (java.io.File. ".env"))))]
                  (println (doctor/report results))
                  (if (doctor/failed? results)
                    (do (println "\n有 [FAIL] 項目：修正後再執行 bb doctor（模型端點尚未檢查）。")
                        (System/exit 1))
                    (do (println "\n檢查模型端點（bb vllm:check）：")
                        (clj "-X:vllm-check"))))}

  dev:models {:doc "Start the local llama.cpp model servers (embed, chat, rerank; VLLM_SETUP.md) that are not running"
              :requires ([replware.levinrag.bb.dev :as dev]
                         [replware.levinrag.bb.dotenv :as dotenv])
              :task (dev/run-task (fn [] (dev/models! (merge (dotenv/read-file ".env") (into {} (System/getenv))))))}

  dev:up {:doc "Start the server (bb serve) and the nREPL in tmux if not running, then bb doctor"
          :requires ([replware.levinrag.bb.dev :as dev])
          :task (dev/run-task dev/up!)}

  dev:down {:doc "Stop the tmux sessions started by dev:models / dev:up"
            :requires ([replware.levinrag.bb.dev :as dev])
            :task (dev/run-task dev/down!)}

  ingest {:doc "Incrementally ingest CORPUS_DIR into DATA_DIR/index.dtlv"
          :task (clj "-M:jvm-opts -m replware.levinrag.ingest.cli ingest")}

  user:create {:doc "Create a user: bb user:create alice --groups all,hr [--admin]"
               :task (apply clj "-M:jvm-opts -m replware.levinrag.auth.cli user:create" *command-line-args*)}

  user:groups {:doc "Replace a user's groups: bb user:groups alice all,hr,finance"
               :task (apply clj "-M:jvm-opts -m replware.levinrag.auth.cli user:groups" *command-line-args*)}

  user:passwd {:doc "Set a user's password (prompted): bb user:passwd alice"
               :task (apply clj "-M:jvm-opts -m replware.levinrag.auth.cli user:passwd" *command-line-args*)}

  user:import {:doc "Create/update the users in a file (eval/users.edn format): bb user:import users.edn [--dry-run]"
               :task (apply clj "-M:jvm-opts -m replware.levinrag.auth.cli user:import" *command-line-args*)}

  acl:report {:doc "Who can read which indexed doc, with warnings: bb acl:report [--users users.edn] [--docs]"
              :task (apply clj "-M:jvm-opts -m replware.levinrag.acl-report" *command-line-args*)}

  token:create {:doc "Create an API token (shown once): bb token:create alice --label cli"
                :task (apply clj "-M:jvm-opts -m replware.levinrag.auth.cli token:create" *command-line-args*)}

  token:revoke {:doc "Revoke an API token by prefix: bb token:revoke <prefix>"
                :task (apply clj "-M:jvm-opts -m replware.levinrag.auth.cli token:revoke" *command-line-args*)}

  eval {:doc "Evaluate retrieval variants: bb eval [--variants lexical,hybrid] [--questions q.edn] [--users u.edn]"
        :task (apply clj "-M:jvm-opts -m replware.levinrag.eval.cli" *command-line-args*)}

  serve {:doc "Start the web server (profile :default) on http://localhost:8000"
         :task (do
                 ;; a fresh checkout has no built CSS (it is gitignored)
                 (when-not (.isFile (java.io.File. output-css-file)) (run 'css-build))
                 (clj "-M:jvm-opts" "-e"
                    (str "(require '[integrant-extras.core :as ig-extras]) "
                         "(ig-extras/run-system {:profile :default :config-path \"config.edn\"}) "
                         "@(promise)")))}

  reindex {:doc "Delete DATA_DIR/index.dtlv and ingest CORPUS_DIR from scratch"
           :task (clj "-M:jvm-opts -m replware.levinrag.ingest.cli reindex")}

  kamal {:doc "Deploy application using Kamal"
         :task (apply shell "kamal" (concat *command-line-args* ["--config-file" ".kamal/deploy.yml"]))}

  browser-check {:doc "Drive the web UI in the local Chrome (Playwright); fail on any JS error"
                 :requires ([babashka.fs :as fs]
                            [babashka.process :as p]
                            [clojure.java.io :as io]
                            [clojure.string :as str])
                 :task (do
                         (run 'css-build)
                         (when-not (fs/exists? "dev/browser/node_modules")
                           (shell {:dir "dev/browser"} "npm ci --no-audit --no-fund"))
                         (let [srv (p/process {:err :inherit} "clojure -M:jvm-opts:test:dev -m browser-server 8765")
                               rdr (io/reader (:out srv))]
                           (try
                             (loop []
                               (let [line (.readLine rdr)]
                                 (cond
                                   (nil? line) (throw (ex-info "browser-server exited before READY" {}))
                                   (str/starts-with? line "READY") nil
                                   :else (recur))))
                             ;; keep draining server output so it never blocks
                             (future (while (.readLine rdr)))
                             (shell "node dev/browser/check.mjs")
                             (finally (p/destroy-tree srv)))))}}
}
