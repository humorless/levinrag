# LevinRAG 設定檔範本。使用方式：
#   cp .env.example .env    # .env 已被 gitignore，不會進版控
#   編輯 .env，再執行 bb doctor 檢查
#
# bb 的 doctor / ingest / reindex / eval / serve / user:*（含 user:import）/
# token:* / vllm:check / acl:report / dev:models 會自動讀取 .env。
# shell 裡已經 export 的變數優先於 .env。
# 格式：KEY=VALUE；# 開頭為註解；含空白或 # 的值請用引號包起來。
# 完整說明：docs/howto/ops.zh-TW.md#環境變數

# ---- 資料與語料（必填）----

# 索引與帳號資料庫放在這裡（index.dtlv、app.dtlv）
DATA_DIR=./data
# 語料目錄：Markdown（.md）或純文字（.txt）；PDF／Office 請先轉成 Markdown
CORPUS_DIR=./corpus
# 語料根目錄沒有 _collection.edn 時的預設可讀群組（逗號分隔）。
# 留空 = 只有 admin 讀得到。
ROOT_READ_GROUPS=all

# ---- 模型端點（必填）：三個 OpenAI 相容 API ----
# 預設值對應 VLLM_SETUP.zh-TW.md 的 vLLM 設定（embedding :8001、rerank :8002、chat :8003）

# 三個端點共用的 API key（沒有驗證的端點也要填一個值）
VLLM_API_KEY=changeme
# 各端點的 key 不同時，分別設定（會覆蓋上面那個）
# VLLM_EMBED_API_KEY=
# VLLM_RERANK_API_KEY=
# VLLM_CHAT_API_KEY=

VLLM_EMBED_BASE_URL=http://localhost:8001/v1
VLLM_EMBED_MODEL=BAAI/bge-m3
# embedding 維度；換模型時要一起改，並執行 bb reindex
VLLM_EMBED_DIMS=1024

VLLM_RERANK_BASE_URL=http://localhost:8002
VLLM_RERANK_PATH=/v1/rerank
VLLM_RERANK_MODEL=BAAI/bge-reranker-v2-m3

VLLM_CHAT_BASE_URL=http://localhost:8003/v1
VLLM_CHAT_MODEL=Qwen/Qwen3-8B

# ---- 本機 Mac 方案：三個 llama.cpp llama-server（bb dev:models 會啟動）----
# 取消下面的註解並覆蓋上面的值（同名變數以最後一次為準）。
# 模型名稱就是 llama-server 的 -a 別名；Qwen3 的 thinking 由 --reasoning off 關掉，
# 不需要 VLLM_CHAT_EXTRA_BODY。見 VLLM_SETUP.zh-TW.md 的「本機替代：llama.cpp」
# VLLM_API_KEY=local
# VLLM_EMBED_MODEL=bge-m3
# VLLM_RERANK_MODEL=bge-reranker-v2-m3
# VLLM_CHAT_MODEL=qwen3-8b

# ---- 選填 ----

# rerank 分數低於此值的段落不送進 prompt；單位依 reranker 後端而定，
# 換後端要重新校準（docs/spikes/rerank-threshold.md）
# VLLM_RERANK_MIN_SCORE=-7.0
# 讀取逾時（毫秒）
# VLLM_EMBED_TIMEOUT_MS=30000
# VLLM_RERANK_TIMEOUT_MS=10000
# VLLM_CHAT_TIMEOUT_MS=120000
# 網頁登入有效時數
# SESSION_MAX_AGE_HOURS=8
# 加密 session cookie 的金鑰：只有正式環境（:prod，Kamal secrets）需要，本機不用設
# SESSION_SECRET_KEY=

# ---- bb dev:models（本機 llama.cpp 方案，見 docs/howto/dev.zh-TW.md）----
# 程式本身不讀 LOCAL_* 變數，只有 bb dev:models 會用。
# 各角色的 llama-server 模型（Hugging Face repo:量化；預設如下）
# LOCAL_EMBED_HF=ggml-org/bge-m3-Q8_0-GGUF
# LOCAL_CHAT_HF=Qwen/Qwen3-8B-GGUF:Q4_K_M
# LOCAL_RERANK_HF=gpustack/bge-reranker-v2-m3-GGUF:Q8_0
# chat 模型的 context 長度（預設 8192）
# LOCAL_CHAT_CONTEXT=8192
